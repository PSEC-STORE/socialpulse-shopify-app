generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Required by @shopify/shopify-app-session-storage-prisma
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

enum PlanTier {
  OWNER_UNLIMITED // Psecstore (psecstore@gmail.com) — Free forever, all features unlocked
  FREE            // 10 posts/month across all global networks
  STARTER         // 100 posts/month + 20 animations
  GROWTH          // 500 posts/month + 100 animations + brand watermark + evergreen
  PRO_AGENCY      // Unlimited posts & animations + multi-brand + priority queue
}

enum BillingProvider {
  OWNER_FREE      // Automatic bypass for psecstore@gmail.com
  SHOPIFY_BILLING // Mandatory for Shopify App Store public installs
  RAZORPAY        // Direct SaaS / agency / custom-app installs
}

enum PostSourceType {
  SHOPIFY_PRODUCT
  SHOPIFY_BLOG
  CUSTOM_MEDIA
  ANIMATED_SHOWCASE
}

enum PostStatus {
  DRAFT
  QUEUED
  RENDERING_VIDEO
  PUBLISHING
  PUBLISHED
  PAUSED_OUT_OF_STOCK
  FAILED
}

enum AnimationPreset {
  NONE
  KEN_BURNS_ZOOM
  SLIDE_CAROUSEL_REEL
  PRICE_BADGE_POP
  SPOTLIGHT_LUXURY
  FLASH_SALE_PULSE
}

model Merchant {
  id                   String          @id @default(cuid())
  shopDomain           String          @unique
  shopName             String?
  ownerEmail           String
  isOwner              Boolean         @default(false)
  planTier             PlanTier        @default(FREE)
  billingProvider      BillingProvider @default(SHOPIFY_BILLING)

  // Billing Identifiers
  shopifySubscriptionId String?
  razorpayCustomerId    String?
  razorpaySubscriptionId String?
  subscriptionStatus    String         @default("ACTIVE")
  currentPeriodEnd      DateTime?

  // Monthly Usage Tracking (reset monthly; ignored when isOwner = true)
  postsUsedThisMonth      Int          @default(0)
  animationsUsedThisMonth Int          @default(0)
  storageUsedMb           Float        @default(0)
  usageResetAt            DateTime     @default(now())

  // Automation & Customization Settings
  automationEnabled     Boolean        @default(true)
  autoPostNewProducts   Boolean        @default(true)
  autoPostNewBlogs      Boolean        @default(true)
  pauseWhenOutOfStock   Boolean        @default(true)
  minStockThreshold     Int            @default(1)
  imageBufferMinutes    Int            @default(2)
  evergreenRepostDays   Int            @default(30)
  timezone              String         @default("Asia/Kolkata")
  dripSlotsPerDay       Int            @default(2)
  dripTimesJson         String         @default("["10:00","18:00"]")

  // Brand & Visual Customization
  brandVoice            String         @default("engaging, modern, conversion-focused")
  defaultHashtags       String         @default("#shopnow #newarrivals #trending")
  utmSource             String         @default("socialpulse")
  utmMedium             String         @default("social_auto")
  utmCampaign           String         @default("catalog_sync")
  watermarkLogoUrl      String?
  watermarkPosition     String         @default("bottom-right")
  brandPrimaryColor     String         @default("#008060")
  linkInBioUrl          String?
  socialProfileKey      String?        // Multi-tenant profile key for Ayrshare/Upload-Post

  channels              SocialChannel[]
  customMedia           CustomMedia[]
  scheduledPosts        ScheduledPost[]
  animationJobs         AnimationJob[]
  billingEvents         BillingEvent[]

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([ownerEmail])
}

model SocialChannel {
  id              String   @id @default(cuid())
  merchantId      String
  merchant        Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  // Supports all 14+ global networks:
  // instagram, facebook, tiktok, linkedin, pinterest, x_twitter, youtube_shorts,
  // threads, bluesky, reddit, snapchat, telegram, google_business, tumblr
  network         String
  accountHandle   String?
  accountId       String?
  isConnected     Boolean  @default(false)
  autoPublish     Boolean  @default(true)
  aspectRatio     String   @default("1:1") // 9:16, 1:1, 4:5, 16:9, 2:3
  includeLink     Boolean  @default(true)
  customCtaText   String?
  defaultBoardId  String?  // For Pinterest boards or Reddit subreddits

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([merchantId, network])
}

model CustomMedia {
  id            String   @id @default(cuid())
  merchantId    String
  merchant      Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  title         String
  mimeType      String   // image/jpeg, image/png, video/mp4
  url           String
  thumbnailUrl  String?
  sizeMb        Float    @default(0)
  width         Int?
  height        Int?
  durationSec   Float?
  linkedProductId String?
  tags          String[]

  createdAt     DateTime @default(now())
}

model ScheduledPost {
  id                String          @id @default(cuid())
  merchantId        String
  merchant          Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  sourceType        PostSourceType
  shopifyResourceId String?         // Product GID or Article GID
  title             String
  destinationUrl    String?
  priceDisplay      String?
  compareAtPrice    String?

  // Selected target platforms (e.g. ["instagram","tiktok","linkedin","pinterest","x_twitter"])
  targetNetworks    String[]
  // JSON map of network -> tailored caption
  captionsJson      Json
  mediaUrls         String[]
  animationPreset   AnimationPreset @default(NONE)
  renderedVideoUrl  String?
  customOverlayText String?
  applyWatermark    Boolean         @default(false)

  scheduledFor      DateTime
  status            PostStatus      @default(QUEUED)
  publishedAt       DateTime?
  platformResults   Json?
  errorMessage      String?
  retryCount        Int             @default(0)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([status, scheduledFor])
  @@index([merchantId])
}

model AnimationJob {
  id               String          @id @default(cuid())
  merchantId       String
  merchant         Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  scheduledPostId  String?
  preset           AnimationPreset
  inputImageUrls   String[]
  aspectRatio      String          @default("9:16") // 9:16 Reels/TikTok/Shorts, 1:1 Feed, 16:9 YouTube
  overlayTitle     String?
  priceBadgeText   String?
  ctaText          String?
  watermarkUrl     String?
  brandColor       String          @default("#008060")
  durationSeconds  Int             @default(8)
  status           String          @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  outputVideoUrl   String?
  errorMessage     String?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model BillingEvent {
  id          String   @id @default(cuid())
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  provider    BillingProvider
  eventType   String
  amount      Float?
  currency    String?
  externalId  String?
  payloadJson Json?
  createdAt   DateTime @default(now())
}
