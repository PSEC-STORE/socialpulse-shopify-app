{
  "name": "psecstore-socialpulse-shopify-app",
  "version": "1.0.0",
  "private": true,
  "description": "SocialPulse Auto-Sync by Psecstore \u2014 Automated Shopify Products & Blogs Publisher across 14+ Global Social Networks with AI Captions, Product Showcase Animations, Custom Media & Dual Billing.",
  "author": "Psecstore <psecstore@gmail.com>",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev",
    "start": "react-router-serve ./build/server/index.js",
    "worker": "tsx app/workers/scheduler.worker.ts",
    "setup": "prisma generate && prisma migrate deploy",
    "db:push": "prisma db push",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@prisma/client": "^6.2.0",
    "@react-router/node": "^7.5.0",
    "@react-router/serve": "^7.5.0",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/polaris": "^13.9.0",
    "@shopify/shopify-app-react-router": "^4.0.3",
    "@shopify/shopify-app-session-storage-prisma": "^6.0.0",
    "bullmq": "^5.34.0",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^5.4.2",
    "razorpay": "^2.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.5.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.5.0",
    "@shopify/cli": "^3.75.0",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.1.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}